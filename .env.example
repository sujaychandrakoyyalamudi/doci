# Local development starts empty and uses deterministic agents without API credentials.
APP_ENV=local
MODEL_PROVIDER=demo
AUTH_MODE=demo
DATABASE_URL=sqlite:///.data/doci.db
CHECKPOINT_URL=.data/checkpoints.db
STORAGE_BACKEND=local
DATA_DIR=.data
QUEUE_BACKEND=local
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# GCP mode: set APP_ENV=production, MODEL_PROVIDER=vertex, AUTH_MODE=firebase,
# STORAGE_BACKEND=gcs, QUEUE_BACKEND=cloud_tasks.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
EMBEDDING_MODEL=gemini-embedding-001
GCS_BUCKET=
DOCUMENT_AI_PROCESSOR=
DOCUMENT_AI_LOCATION=us
CLOUD_TASKS_QUEUE=doci-review
WORKER_URL=
TASK_SERVICE_ACCOUNT=
# PostgreSQL: use postgresql+psycopg:// for SQLAlchemy, postgresql:// for checkpoints.
# DATABASE_URL=postgresql+psycopg://doci:REPLACE_LOCALLY@localhost:5432/doci
# CHECKPOINT_URL=postgresql://doci:REPLACE_LOCALLY@localhost:5432/doci

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doci
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Optional relationship index (the SQL store remains authoritative).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Optional separate A2A reviewer. Private URL with IAM authentication in GCP.
REVIEWER_A2A_URL=

# Optional Docker Compose password. Keep real values in an ignored .env file.
LOCAL_POSTGRES_PASSWORD=
